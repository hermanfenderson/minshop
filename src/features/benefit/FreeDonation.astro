---
import { formatPrice } from '../../config';
import ProductImage from '../products/ProductImage.astro';
import { amountInputStep, amountInputValue } from './amount';
import type { Product } from '../products/db';

/**
 * Benefit Mode: the free donation (findFreeDonationProduct, e.g. Gratitude)
 * offered in a modal when the supporter goes on to donate and the cart does not
 * hold it yet — a question, never a default: the field starts empty and «No,
 * thanks» goes on unchanged. The layout's script opens it from any trigger
 * carrying data-free-donation-ask={id}; without JavaScript the trigger simply
 * goes on. Once added, it is the cart's last line, «Free donation».
 */
interface Props {
  product: Product;
  currency: string;
  capCents: number;
  /** Unique per page: the drawer and the cart page each have their own. */
  id: string;
}

const { product, currency, capCents, id } = Astro.props;
const { t } = Astro.locals.i18n;
const minimum = formatPrice(product.price_cents, undefined, Astro.locals.i18n.intl);
---

<dialog
  id={id}
  data-free-donation-modal
  class="m-auto max-h-[92vh] w-[min(26rem,calc(100vw-2rem))] overflow-y-auto rounded-xl border border-line bg-paper p-0 text-current shadow-2xl backdrop:bg-black/60"
  aria-labelledby={`${id}-title`}
>
  <form method="POST" action={Astro.locals.urls.href('/api/cart')} data-free-donation-form>
    <input type="hidden" name="_action" value="add" />
    <input type="hidden" name="product_id" value={product.public_id} />
    {/* The picture leads, in full. */}
    <ProductImage imageKey={product.image_key} alt="" usage="card" sizes="28rem" class="aspect-square w-full object-cover" />
    <div class="p-6">
      <h2 id={`${id}-title`} class="text-xl leading-snug">{t('benefit.cart.free.question')}</h2>
      <p class="mt-2 text-sm text-muted">{t('benefit.cart.free.hint', { price: minimum })}</p>
      <label class="mt-5 flex items-center gap-3">
        <span class="text-xs uppercase tracking-widest text-muted">{t('benefit.cart.contribution')}</span>
        <input
          type="number"
          name="amount"
          inputmode="decimal"
          required
          min={amountInputValue(product.price_cents, currency)}
          max={amountInputValue(capCents, currency)}
          step={amountInputStep(currency)}
          class="w-28 border-b border-line bg-transparent py-1 text-right text-lg tabular-nums focus:border-brand focus:outline-none"
        />
        <span class="text-muted">{currency.toUpperCase() === 'EUR' ? '€' : currency.toUpperCase()}</span>
      </label>
      {/* «Add» in every colour, «No, thanks» grey and a little sad (Mauro, 2026-10-30). */}
      <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">
        <button type="button" data-free-donation-skip class="self-center px-2 py-2 text-xs lowercase tracking-wide text-gray-400 opacity-70 hover:opacity-100">
          {t('benefit.cart.free.skip')} 🙁
        </button>
        <button
          type="submit"
          class="rounded-full px-7 py-3 text-sm font-semibold uppercase tracking-wider text-white shadow-lg transition hover:scale-[1.03] hover:shadow-xl"
          style="background: linear-gradient(90deg, #f7b500, #f76b1c, #e63946, #b5179e, #5e60ce, #00b4d8, #2ec4b6); text-shadow: 0 1px 2px rgba(0,0,0,.35);"
        >
          {t('benefit.cart.free.add')} ✨
        </button>
      </div>
    </div>
  </form>
</dialog>
