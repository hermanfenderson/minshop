---
import { formatPrice } from '../../config';
import { amountInputStep, amountInputValue } from './amount';
import type { Product } from '../products/db';

/**
 * Benefit Mode cart: «Add a free donation». Posts the shop's plain donation
 * product (findFreeDonationProduct) with the chosen amount, like its own page
 * does; once it is in the cart its line carries the amount field instead.
 */
interface Props {
  product: Product;
  currency: string;
  capCents: number;
  /** The drawer: tighter spacing, smaller field. */
  compact?: boolean;
  /** Already in the cart at this amount: the field shows it and the button changes it. */
  currentCents?: number | null;
}

const { product, currency, capCents, compact = false, currentCents = null } = Astro.props;
const { t } = Astro.locals.i18n;
const minimum = formatPrice(product.price_cents, undefined, Astro.locals.i18n.intl);
const id = compact ? 'free-donation-drawer' : 'free-donation';
---

<form method="POST" action={Astro.locals.urls.href('/api/cart')} class:list={[compact ? 'mt-4' : 'mt-6', 'rounded-md border border-dashed border-line px-4 py-3']}>
  <input type="hidden" name="_action" value="add" />
  <input type="hidden" name="product_id" value={product.public_id} />
  <label for={id} class="block text-xs uppercase tracking-widest text-muted">{t('benefit.cart.free.label')}</label>
  <div class="mt-2 flex items-center gap-3">
    <input
      id={id}
      type="number"
      name="amount"
      inputmode="decimal"
      required
      min={amountInputValue(product.price_cents, currency)}
      max={amountInputValue(capCents, currency)}
      step={amountInputStep(currency)}
      value={currentCents != null ? amountInputValue(currentCents, currency) : undefined}
      placeholder={amountInputValue(product.price_cents, currency)}
      class:list={[compact ? 'w-20 text-sm' : 'w-28', 'border-b border-line bg-transparent py-1 text-right tabular-nums focus:border-brand focus:outline-none']}
    />
    <button type="submit" class="text-xs font-medium uppercase tracking-widest text-brand hover:text-brand-hover">
      {currentCents != null ? t('benefit.cart.change') : t('benefit.cart.free.add')}
    </button>
  </div>
  <p class="mt-2 text-xs text-muted">{t('benefit.cart.free.hint', { price: minimum })}</p>
</form>
