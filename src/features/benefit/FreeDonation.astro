---
import { formatPrice } from '../../config';
import ProductImage from '../products/ProductImage.astro';
import { amountInputStep, amountInputValue } from './amount';
import { suggestedFreeDonationCents } from './freeDonation';
import type { Product } from '../products/db';

/**
 * Benefit Mode: the free donation (findFreeDonationProduct, e.g. Gratitude)
 * offered in a modal when the supporter goes on to donate and the cart does not
 * hold it yet — a question, never a default: the field starts empty and «No,
 * thanks» goes on unchanged. The layout's script opens it from any trigger
 * carrying data-free-donation-ask={id}; without JavaScript the trigger simply
 * goes on. Once added, it is the cart's last line, «Free donation».
 */
interface Props {
  product: Product;
  currency: string;
  capCents: number;
  /** Unique per page: the drawer and the cart page each have their own. */
  id: string;
}

const { product, currency, capCents, id } = Astro.props;
const { t } = Astro.locals.i18n;
const minimum = formatPrice(product.price_cents, undefined, Astro.locals.i18n.intl);
---

<dialog
  id={id}
  data-free-donation-modal
  class="m-auto max-h-[92vh] w-[min(31rem,calc(100vw-2rem))] overflow-y-auto rounded-xl border border-line bg-paper p-0 text-current shadow-2xl backdrop:bg-black/60"
  aria-labelledby={`${id}-title`}
>
  <form method="POST" action={Astro.locals.urls.href('/api/cart')} class="relative" data-free-donation-form>
    <input type="hidden" name="_action" value="add" />
    <input type="hidden" name="product_id" value={product.public_id} />
    {/* Closing without choosing stays in the cart; the question comes back next time. */}
    <button
      type="button"
      data-free-donation-close
      aria-label={t('storefront.cartDrawer.close')}
      class="absolute right-3 top-3 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-black/55 text-2xl leading-none text-white hover:bg-black/75"
    >
      ×
    </button>
    {/* The picture leads, in full. */}
    <ProductImage imageKey={product.image_key} alt="" usage="card" sizes="28rem" class="aspect-square w-full object-cover" />
    <div class="p-6">
      <h2 id={`${id}-title`} class="text-2xl leading-snug">{t('benefit.cart.free.question')}</h2>
      <p class="mt-2 text-base text-muted">{t('benefit.cart.free.hint', { price: minimum })}</p>
      <label class="mt-5 flex items-center gap-3">
        <span class="text-sm uppercase tracking-widest text-muted">{t('benefit.cart.contribution')}</span>
        <input
          type="number"
          name="amount"
          inputmode="decimal"
          required
          min={amountInputValue(product.price_cents, currency)}
          max={amountInputValue(capCents, currency)}
          step={amountInputStep(currency)}
          value={amountInputValue(suggestedFreeDonationCents(product.price_cents, currency), currency)}
          class="w-32 border-b border-line bg-transparent py-1 text-right text-2xl tabular-nums focus:border-brand focus:outline-none"
        />
        <span class="text-xl text-muted">{currency.toUpperCase() === 'EUR' ? '€' : currency.toUpperCase()}</span>
      </label>
      {/* «Add» in every colour, «No, thanks» grey and a little sad (Mauro, 2026-10-30). */}
      <div class="mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
        <button type="button" data-free-donation-skip class="whitespace-nowrap rounded-full bg-gray-500/70 px-4 py-3 text-base text-gray-200 transition hover:bg-gray-500">
          <span class="inline-flex items-center gap-2">{t('benefit.cart.free.skip')} <span class="text-2xl leading-none" aria-hidden="true">🙁</span></span>
        </button>
        <button
          type="submit"
          class="whitespace-nowrap rounded-full px-6 py-3 text-base font-semibold uppercase tracking-wide text-white shadow-lg transition hover:scale-[1.03] hover:shadow-xl"
          data-rainbow
        >
          {t('benefit.cart.free.add')} <span data-sparkle aria-hidden="true">✨</span>
        </button>
      </div>
    </div>
  </form>
</dialog>

<style is:inline>
  /* «Add» in every colour, flowing like an old gif; still for reduced motion. */
  /* Festive on purpose (Mauro, 2026-10-30): the colours run fast, the button
     hops now and then, and the sparkle is large, glows and twinkles. Still
     for reduced motion. */
  [data-rainbow] {
    background: linear-gradient(90deg, #ffbe0b, #fb5607, #ff006e, #8338ec, #3a86ff, #06d6a0, #ffbe0b);
    background-size: 300% 100%;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    animation:
      rainbow-flow 1.4s linear infinite,
      rainbow-hop 2.8s ease-in-out infinite;
  }
  [data-rainbow]:hover {
    animation-duration: 0.7s, 2.8s;
  }
  [data-sparkle] {
    display: inline-block;
    font-size: 1.6em;
    line-height: 0;
    vertical-align: -0.15em;
    margin-left: 0.15em;
    filter: drop-shadow(0 0 3px #fff) drop-shadow(0 0 6px #ffd60a);
    animation: sparkle-twinkle 1.2s ease-in-out infinite;
  }
  @keyframes rainbow-flow {
    from { background-position: 0% 50%; }
    to { background-position: 150% 50%; }
  }
  @keyframes rainbow-hop {
    0%, 70%, 100% { transform: translateY(0) rotate(0); }
    76% { transform: translateY(-4px) rotate(-2deg); }
    82% { transform: translateY(0) rotate(2deg); }
    88% { transform: translateY(-2px) rotate(-1deg); }
  }
  @keyframes sparkle-twinkle {
    0%, 100% { transform: scale(1) rotate(0); }
    50% { transform: scale(1.3) rotate(18deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-rainbow],
    [data-sparkle] { animation: none; }
  }
</style>
