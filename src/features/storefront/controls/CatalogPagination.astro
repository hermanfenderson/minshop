---
import type { StorefrontPaginationModel } from '../models';
import { storefrontI18n, type I18n } from './i18n';

/**
 * Page links. Owns the navigation landmark, `aria-current="page"`, and the
 * rel=prev/next hints crawlers use to understand a paginated series — all of
 * which are easy to drop when restyling, and invisible when they go missing.
 */
interface Props {
  model: StorefrontPaginationModel;
  class?: string;
  i18n?: I18n;
}

const {
  model,
  class: className = 'mt-14 flex items-center justify-center gap-1',
  i18n,
} = Astro.props;
const { t } = storefrontI18n(i18n);
const linkCls = 'px-3 py-1.5 text-xs uppercase tracking-widest text-muted hover:text-brand';
---

{
  model.totalPages > 1 && (
    <nav class={className} aria-label={t('common.pagination.label')}>
      {model.prevHref && (
        <a href={model.prevHref} class={linkCls} rel="prev">
          {t('common.pagination.prev')}
        </a>
      )}
      {model.items.map((item) =>
        item.page === null ? (
          <span class="px-2 text-xs text-faint">…</span>
        ) : (
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            class={`${linkCls} ${item.current ? 'font-medium text-brand' : ''}`}
          >
            {item.page}
          </a>
        ),
      )}
      {model.nextHref && (
        <a href={model.nextHref} class={linkCls} rel="next">
          {t('common.pagination.next')}
        </a>
      )}
    </nav>
  )
}
