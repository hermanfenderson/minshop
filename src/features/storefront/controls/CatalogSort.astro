---
import type { StorefrontSortModel } from '../models';
import { storefrontI18n, type I18n } from './i18n';

/**
 * Sort controls. The hrefs arrive already built — including the direction flip
 * on the active field and the deliberate omission of `page` — so a template can
 * restyle these without changing which URLs the catalog exposes to crawlers or
 * to the cache.
 */
interface Props {
  model: StorefrontSortModel;
  class?: string;
  i18n?: I18n;
}

const {
  model,
  class: className =
    'mb-8 flex flex-wrap items-baseline gap-x-5 gap-y-1 text-xs uppercase tracking-widest text-muted',
  i18n,
} = Astro.props;
const { t } = storefrontI18n(i18n);
---

<div class={className}>
  <span>{t('storefront.catalog.sort')}</span>
  {
    model.options.map((option) => (
      <a
        href={option.href}
        aria-current={option.current ? 'true' : undefined}
        class={`hover:text-brand ${option.current ? 'text-brand' : ''}`}
      >
        {option.label}
        {option.direction === 'asc' ? ' ↑' : option.direction === 'desc' ? ' ↓' : ''}
      </a>
    ))
  }
</div>
