---
import type { CatalogPageModel } from '../../features/storefront/models';
import ProductCard from './ProductCard.astro';
import SupportIntro from './SupportIntro.astro';
import CatalogSort from '../../features/storefront/controls/CatalogSort.astro';
import CatalogPagination from '../../features/storefront/controls/CatalogPagination.astro';
import { storefrontI18n, type I18n } from '../../features/storefront/controls/i18n';

/**
 * STORE-OWNED. Edit freely — this file belongs to your store.
 *
 * The catalog, rendered at both `/` and `/products`. It performs no queries and
 * parses no query parameters: every product, link, and URL on `model` is
 * already built and bounded.
 *
 * Keep <CatalogSort> and <CatalogPagination>. Their hrefs encode the query
 * semantics the catalog's canonical URLs and caching depend on, and their
 * landmarks and rel hints are what make a paginated series legible to crawlers.
 *
 * See CUSTOMIZING.md for the full contract.
 */
interface Props {
  model: CatalogPageModel;
  /** The request's translator; English when omitted. */
  i18n?: I18n;
}

const { model } = Astro.props;
const i18n = storefrontI18n(Astro.props.i18n);
const { t } = i18n;
// The three ways to give open the first page only; later pages are just more perks.
const firstPage = model.pagination.page === 1;
// Gratitude's URL, built from a card's: a template constructs no URLs from the
// request, and every product lives next to the others under the same prefix.
const gratitudeHref = model.products[0]?.href.replace(/[^/]+$/, 'gratitude') ?? null;
// The freewill donation has its own place above (Mauro 2026-10-30): neither the
// product nor its category is listed with the perks.
const isFreeDonation = (href: string) => /\/gratitude$/.test(href);
const products = model.products.filter((card) => !isFreeDonation(card.href));
const categories = model.categories.filter((category) => !isFreeDonation(category.href));
---

<div class="mb-10">
  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">{model.eyebrow}</p>
  <h1 class="mt-2 font-serif text-4xl font-medium tracking-tight sm:text-5xl">{model.heading}</h1>
</div>

{firstPage && <SupportIntro i18n={i18n} perksAnchor="omaggi" gratitudeHref={gratitudeHref} />}

<div id="omaggi" class="scroll-mt-6"></div>

{
  categories.length > 0 && (
    <div class="mb-12 flex flex-wrap gap-x-6 gap-y-2 text-xs uppercase tracking-widest text-muted">
      {categories.map((category) => (
        <a
          href={category.href}
          class="border-b-[3px] border-transparent pb-0.5 hover:border-nav-accent"
        >
          {category.text}
        </a>
      ))}
    </div>
  )
}

<CatalogSort model={model.sort} i18n={i18n} />

{
  /* role="status" is the contract, not the wording: an empty catalog must
     announce itself to assistive technology rather than rendering a blank
     grid. Reword it freely; keep the role and keep it non-empty. */
  products.length === 0 && (
    <p role="status" class="text-muted">
      {t('storefront.catalog.empty')}
    </p>
  )
}

<ul class="grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-3 lg:grid-cols-4">
  {products.map((card, i) => <ProductCard card={card} index={i} i18n={i18n} />)}
</ul>

<CatalogPagination model={model.pagination} i18n={i18n} />
