---
import type { StorefrontShellModel } from '../../features/storefront/models';
import StoreLanguageSwitcher from '../../features/storefront/controls/StoreLanguageSwitcher.astro';
import { storefrontI18n, type I18n } from '../../features/storefront/controls/i18n';

/**
 * Market — a compact footer strip.
 *
 * Utility links, not a sitemap. Kept to one line at desktop so it reads as the
 * end of a tool rather than a second navigation surface.
 */
interface Props {
  model: StorefrontShellModel;
  /** The request's translator; English when omitted. */
  i18n?: I18n;
}

const { model } = Astro.props;
const { t } = storefrontI18n(Astro.props.i18n);
---

<footer class="mt-10 border-t-2 border-gray-900 bg-[color:var(--market-surface)]">
  <div
    class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-5 gap-y-2 px-4 py-4 text-[11px] font-semibold text-[color:var(--market-muted)]"
  >
    <span class="font-serif uppercase tracking-wide text-gray-900">&copy; {model.storeName}</span>
    {
      model.footerLinks.length > 0 && (
        <nav aria-label={t('storefront.footer.nav')} class="flex flex-wrap items-center gap-x-5 gap-y-2">
          {model.footerLinks.map((link) => (
            <a href={link.href} class="hover:text-gray-900">
              {link.text}
            </a>
          ))}
        </nav>
      )
    }
    <StoreLanguageSwitcher languages={model.languages} class="ml-auto flex flex-wrap items-center gap-x-4 gap-y-2" linkClass="hover:text-gray-900" />
  </div>
</footer>
