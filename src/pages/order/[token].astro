---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { formatPrice, getConfig } from '../../config';
import { getOrderByPublicId, listOrderItems } from '../../features/orders/db';
import { orderNumber } from '../../features/orders/number';
import { isLegacyPublicId, publicIdToken } from '../../features/ids/publicId.ts';
import { isAccessToken } from '../../features/ids/token.ts';
import { resolveAccessToken } from '../../features/orders/guestAccess.ts';
import { clearCart } from '../../features/cart/cart';
import { catalogPath } from '../../features/settings/home';
import { getReservationStatusSnapshot } from '../../features/orders/reservations';
import { pendingOrderState } from '../../features/orders/pendingState';
import { listOrderReceipts } from '../../features/receipts';
import { listPackages, loadPackableLines, packedQuantities, waitingLines } from '../../features/fulfillment/packages';
import { carrierName, trackingUrl } from '../../features/orders/tracking';

// Guest access: new orders are addressed ONLY by their otk_ access token
// (resolved through the registry); legacy orders keep their pre-cutover
// public-id links. A bare ord_ public ID never grants access — same not-found
// as an unknown token.
const { t, th } = Astro.locals.i18n;
const { token } = Astro.params;
let order = null;
let access = null;
if (token && isAccessToken(token)) {
  access = await resolveAccessToken(env.DB, token);
  order = access ? await getOrderByPublicId(env.DB, access.order_public_id) : null;
} else if (token && isLegacyPublicId(token)) {
  order = await getOrderByPublicId(env.DB, token);
} else if (token) {
  return new Response(t('order.error.notFound'), { status: 404 });
}

// This page carries a capability URL: never cache it, never leak it in referrers.
Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('referrer-policy', 'no-referrer');

// The webhook creates the order asynchronously, so the customer can land here
// before it exists. If found, it's confirmed — clear the cart and show it.
// clearCart (not a raw delete) so the script-readable count cookie goes with it
// and the header badge can't survive the purchase.
if (order) clearCart(Astro.cookies);
const items = order ? await listOrderItems(env.DB, order.id) : [];
// Benefit Mode: the receipts issued for this order, once their snapshot exists.
// Shipping (migration 0049): every package with its tracking and contents, and
// what is still being prepared. Only behind the private link, like downloads.
const showShipping = Boolean(order && isAccessToken(token) && order.status === 'paid');
const packages = showShipping ? await listPackages(env.DB, order!.id) : [];
const stillWaiting = showShipping
  ? waitingLines(await loadPackableLines(env.DB, order!.id), await packedQuantities(env.DB, order!.id))
  : [];
const shipDate = (iso: string | null) =>
  iso ? new Date(iso.includes('T') ? iso : `${iso.replace(' ', 'T')}Z`).toLocaleDateString(Astro.locals.i18n.locale, { day: 'numeric', month: 'long' }) : null;
const receipts = order?.donor ? (await listOrderReceipts(env.DB, order.id)).filter((r) => r.document) : [];

// Customer reference: the ord_ token portion for new orders; legacy orders keep
// showing their previously communicated calculated number.
const orderRef = order
  ? (publicIdToken(order.public_id ?? '', 'order') ?? String(orderNumber(order.id, getConfig().orderNumber)))
  : null;

// Human label for the rail the order was paid on (NULL = legacy, hidden).
// Stripe, Lightning and Bitcoin are names, so they stay as they are in every
// language. Stripe is named rather than "Card": its Checkout also takes SEPA,
// wallets, Klarna… and the order does not record which one the buyer chose.
const PAYMENT_LABELS: Record<string, string> = {
  stripe: 'Stripe',
  lightning: 'Lightning',
  opennode: 'Bitcoin',
  demo: t('order.payment.demo'),
};
const paymentLabel = order?.payment_method ? PAYMENT_LABELS[order.payment_method] ?? null : null;
// The catalog is at / until the home page is pointed elsewhere.
// Amounts in the page's language: '75,00 €' in Italian, not '€75.00'.
const money = (cents: number) => formatPrice(cents, order?.currency, Astro.locals.i18n.intl);
const shopHref = Astro.locals.urls.href(catalogPath(Astro.locals.settings?.homePage));

// No order yet: the reservation behind the link says whether one is coming. A
// failed or expired payment never becomes an order, so it must not read as
// "confirming"; a clearing bank debit can take days, so it polls slowly.
const pending = !order && access
  ? pendingOrderState((await getReservationStatusSnapshot(env.DB, access.order_public_id))?.status)
  : 'confirming';
const REFRESH_SECONDS: Record<string, number> = { confirming: 3, processing: 30 };
const refresh = REFRESH_SECONDS[pending];
const PENDING_TEXT = {
  processing: { heading: t('order.processing.heading'), body: t('order.processing.body') },
  failed: { heading: t('order.failed.heading'), body: t('order.failed.body') },
  expired: { heading: t('order.expired.heading'), body: t('order.expired.body') },
};
const pendingText = pending === 'confirming' ? null : PENDING_TEXT[pending];
const pageTitle = order
  ? t('order.page.titleConfirmed')
  : pendingText?.heading ?? t('order.page.titleConfirming');
---

<Layout title={pageTitle}>
  {
    order ? (
      <Fragment>
        <h1 class="mb-2 font-serif text-3xl tracking-tight sm:text-4xl">{t('order.confirmed.heading')}</h1>
        <p class="mb-6 text-sm text-muted">
          {order.email
            ? t('order.confirmed.referenceWithReceipt', { ref: orderRef ?? '', email: order.email })
            : t('order.confirmed.reference', { ref: orderRef ?? '' })}
        </p>

        <div class="overflow-hidden rounded-lg border border-line bg-surface">
          <table class="w-full text-left text-sm">
            <thead class="bg-surface text-muted">
              <tr>
                <th class="px-4 py-2 font-medium">{t('order.confirmed.item')}</th>
                <th class="px-4 py-2 font-medium">{t('order.confirmed.qty')}</th>
                <th class="px-4 py-2 font-medium">{t('order.confirmed.lineTotal')}</th>
              </tr>
            </thead>
            <tbody>
              {items.map((it) => (
                <tr class="border-t border-line">
                  <td class="px-4 py-2">{it.name}</td>
                  <td class="px-4 py-2">{it.quantity}</td>
                  <td class="px-4 py-2">
                    {money(it.price_cents * it.quantity)}
                  </td>
                </tr>
              ))}
              {/* What lies between the lines and the total, so the sum adds up
                  on the page without opening the receipt. */}
              {order.shipping_cents > 0 && (
                <tr class="border-t border-line text-muted">
                  <td class="px-4 py-2" colspan="2">{t('order.confirmed.shipping')}</td>
                  <td class="px-4 py-2">{money(order.shipping_cents)}</td>
                </tr>
              )}
              {order.discount_cents > 0 && (
                <tr class="border-t border-line text-muted">
                  <td class="px-4 py-2" colspan="2">{t('order.confirmed.discount')}</td>
                  <td class="px-4 py-2">−{money(order.discount_cents)}</td>
                </tr>
              )}
              {order.tax_cents > 0 && (
                <tr class="border-t border-line text-muted">
                  <td class="px-4 py-2" colspan="2">{t('order.confirmed.tax')}</td>
                  <td class="px-4 py-2">{money(order.tax_cents)}</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>

        <p class="mt-4 text-lg font-semibold">
          {t('order.confirmed.total', { amount: money(order.amount_total_cents) })}
        </p>
        {showShipping && (packages.length > 0 || (stillWaiting.length > 0 && order.fulfillment_status !== 'fulfilled')) && (
          <section class="mt-8 rounded-lg border border-line bg-surface p-5" data-shipping>
            <h2 class="font-serif text-2xl">{t('order.shipping.heading')}</h2>
            {packages.length === 0 && <p class="mt-3 text-sm text-muted">{t('order.shipping.none')}</p>}
            <ul class="mt-3 space-y-4">
              {packages.map((p, i) => {
                const link = p.tracking_url ?? trackingUrl(p.carrier, p.tracking_number);
                const date = shipDate(p.shipped_at ?? p.created_at);
                return (
                  <li>
                    <p class="font-medium">
                      {t('order.shipping.package', { n: i + 1 })}
                      {date && <span class="font-normal text-muted"> · {t('order.shipping.shippedOn', { date })}</span>}
                    </p>
                    {p.items.length > 0 && (
                      <p class="text-sm text-muted">{p.items.map((it) => (it.quantity > 1 ? `${it.quantity} × ${it.name}` : it.name)).join(' · ')}</p>
                    )}
                    {p.tracking_number && (
                      <p class="text-sm">
                        {p.carrier && <>{carrierName(p.carrier, Astro.locals.i18n)} · </>}
                        {link ? (
                          <a href={link} target="_blank" rel="noopener" class="border-b border-brand text-brand">
                            {t('order.shipping.track')} ({p.tracking_number})
                          </a>
                        ) : (
                          <span class="tabular-nums">{p.tracking_number}</span>
                        )}
                      </p>
                    )}
                  </li>
                );
              })}
            </ul>
            {stillWaiting.length > 0 && order.fulfillment_status !== 'fulfilled' && (
              <p class="mt-4 text-sm">
                <span class="font-medium">{t('order.shipping.waiting')}</span>{' '}
                <span class="text-muted">{stillWaiting.map((l) => (l.quantity - l.packed > 1 ? `${l.quantity - l.packed} × ${l.name}` : l.name)).join(' · ')}</span>
              </p>
            )}
          </section>
        )}
        {items.some((item) => item.file_key) && isAccessToken(token) && (
          <section class="mt-8 rounded-lg border border-line bg-surface p-5">
            <h2 class="font-serif text-2xl">{t('order.downloads.heading')}</h2>
            <ul class="mt-3 space-y-3">
              {items.filter((item) => item.file_key && item.public_id).map((item) => (
                <li class="flex flex-wrap items-center justify-between gap-3">
                  <span>
                    <strong>{item.file_name ?? item.name}</strong>
                    {item.file_mime && <small class="ml-2 text-muted">{item.file_mime}</small>}
                    {item.file_size_bytes != null && (
                      <small class="ml-2 text-muted">{t('order.downloads.sizeKb', { size: Math.ceil(item.file_size_bytes / 1024) })}</small>
                    )}
                  </span>
                  {order.refunded_cents >= order.amount_total_cents ? (
                    <span class="text-sm text-muted">{t('order.downloads.unavailableAfterRefund')}</span>
                  ) : (
                    <a
                      href={Astro.locals.urls.href(`/order/${token}/download/${item.public_id}`)}
                      class="rounded-md bg-brand px-4 py-2 text-sm font-medium text-on-brand hover:bg-brand-hover"
                    >{t('order.downloads.download')}</a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
        {order.donor && isAccessToken(token) && (
          <section class="mt-8 rounded-lg border border-line bg-surface p-5" data-receipts>
            <h2 class="font-serif text-2xl">{t('benefit.receipt.heading')}</h2>
            {receipts.length === 0 ? (
              <p class="mt-3 text-sm text-muted">{t('benefit.receipt.pending')}</p>
            ) : (
              <ul class="mt-3 space-y-2">
                {receipts.map((r) => (
                  <li>
                    <a
                      href={Astro.locals.urls.href(`/order/${token}/receipt/${r.public_id}`)}
                      class="border-b border-line hover:text-brand"
                    >{t('benefit.receipt.download', { title: t(`benefit.receipt.title.${r.kind === 'manual_donation' ? 'donation' : r.kind}`), label: r.label })}</a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        )}
        {paymentLabel && (
          <p class="mt-1 text-sm text-muted">{t('order.confirmed.paidWith', { method: paymentLabel })}</p>
        )}
        {/* Amounts only — the internal note is for the merchant, not the buyer. */}
        {order.refunded_cents > 0 && (
          <p class="mt-2 text-sm text-muted">
            {order.refunded_cents >= order.amount_total_cents
              ? t('order.confirmed.refundedFull', {
                  amount: money(order.refunded_cents),
                })
              : t('order.confirmed.refundedPartial', {
                  amount: money(order.refunded_cents),
                  remaining: money(order.amount_total_cents - order.refunded_cents),
                })}
          </p>
        )}
        <a href={shopHref} class="mt-6 inline-block text-accent hover:underline">
          &larr; {t('order.confirmed.continueShopping')}
        </a>
      </Fragment>
    ) : (
      <Fragment>
        {/* Order not recorded yet — poll while one can still arrive (no JS). */}
        {refresh && <meta http-equiv="refresh" content={String(refresh)} />}
        {!pendingText ? (
          <Fragment>
            <h1 class="mb-2 font-serif text-3xl tracking-tight sm:text-4xl">{t('order.confirming.heading')}</h1>
            <p class="text-muted">
              <Fragment set:html={th('order.confirming.body')} />
            </p>
          </Fragment>
        ) : (
          <Fragment>
            <h1 class="mb-2 font-serif text-3xl tracking-tight sm:text-4xl">{pendingText.heading}</h1>
            <p class="text-muted">{pendingText.body}</p>
            {pending !== 'processing' && (
              <a href={Astro.locals.urls.href('/cart')} class="mt-6 inline-block text-accent hover:underline">
                &larr; {t('order.pending.backToCart')}
              </a>
            )}
          </Fragment>
        )}
      </Fragment>
    )
  }
</Layout>
