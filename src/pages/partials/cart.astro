---
import { env } from 'cloudflare:workers';
import { formatPrice, getConfig } from '../../config';
import { benefitRules, isSingleUnitContribution } from '../../features/benefit/mode';
import FreeDonation from '../../features/benefit/FreeDonation.astro';
import { findFreeDonationProduct, freeDonationLast } from '../../features/benefit/freeDonation';
import { amountInputStep, amountInputValue } from '../../features/benefit/amount';
import { catalogPath } from '../../features/settings/home';
import { readCart, resolveCart, cartCount } from '../../features/cart/cart';
import ProductImage from '../../features/products/ProductImage.astro';
import { getSetting } from '../../features/settings/db';

// Astro partial: renders ONLY this fragment (no surrounding document), so the
// cart drawer can fetch and inject it. Server-rendered, so pricing/stock still
// come from D1 — the drawer holds no client-side cart state.
export const partial = true;
export const prerender = false;

const cart = readCart(Astro.cookies);
const currency = getConfig().currency;
const benefit = benefitRules(Astro.locals.settings, currency);
const [{ lines: cartLines, subtotalCents }, imageDeliverySetting, freeDonationProduct] = await Promise.all([
  resolveCart(env.DB, cart, Astro.locals.contentLocale, benefit),
  getSetting(env.DB, 'image_delivery'),
  benefit ? findFreeDonationProduct(env.DB) : Promise.resolve(null),
]);
// The free donation (Gratitude) closes the list, with its amount; while it is
// missing, an invitation takes its place; alone, it invites to choose a perk.
const { lines, freeLine } = freeDonationLast(cartLines, freeDonationProduct);
const onlyFreeDonation = !!freeLine && lines.length === 1;
const offerFreeDonation = !!(benefit && freeDonationProduct && !freeLine);
const shopHref = Astro.locals.urls.href(catalogPath(Astro.locals.settings?.homePage));
const imageDelivery = imageDeliverySetting === 'cloudflare' ? 'cloudflare' : 'original';
const count = cartCount(cart);
const { t } = Astro.locals.i18n;
---

<div data-cart-count={count}>
  {
    lines.length === 0 ? (
      <p class="py-10 text-center text-sm text-muted">
        {t('cart.page.empty')}
      </p>
    ) : (
      <Fragment>
        <ul class="divide-y divide-line">
          {lines.map((l) => (
            <li class="flex gap-4 py-4">
              <a href={Astro.locals.urls.product(l.product.slug)} class="shrink-0">
                <ProductImage
                  imageKey={l.product.image_key}
                  alt=""
                  sizes="64px"
                  fade
                  usage="thumbnail"
                  delivery={imageDelivery}
                  class="h-16 w-16 rounded object-cover"
                />
              </a>
              <div class="flex flex-1 flex-col">
                <a href={Astro.locals.urls.product(l.product.slug)} class="text-sm leading-snug hover:text-brand">
                  {l === freeLine ? t('benefit.cart.free.name') : l.product.name}
                </a>
                {(l.variant || l.extras.length > 0) && (
                  <span class="mt-0.5 text-xs text-muted">
                    {[l.variant?.label, ...l.extras.map((e) => e.label)].filter(Boolean).join(' · ')}
                  </span>
                )}
                <span class="mt-1 text-xs tabular-nums text-muted">
                  {formatPrice(l.unitPriceCents, undefined, Astro.locals.i18n.intl)}
                </span>
                <div class="mt-auto flex flex-wrap items-center gap-4 pt-2">
                  {benefit && l === freeLine && (
                    <form method="POST" action={Astro.locals.urls.href('/api/cart')} class="flex items-center gap-2">
                      <input type="hidden" name="_action" value="amount" />
                      <input type="hidden" name="key" value={l.key} />
                      <input
                        type="number"
                        name="amount"
                        inputmode="decimal"
                        required
                        min={amountInputValue(l.minimumCents, currency)}
                        max={amountInputValue(benefit.capCents, currency)}
                        step={amountInputStep(currency)}
                        value={amountInputValue(l.unitPriceCents, currency)}
                        aria-label={t('benefit.cart.contribution')}
                        class="w-20 border-b border-line bg-transparent py-0.5 text-right text-sm tabular-nums focus:border-brand focus:outline-none"
                      />
                      <button type="submit" class="text-xs uppercase tracking-widest text-faint hover:text-brand">
                        {t('benefit.cart.change')}
                      </button>
                    </form>
                  )}
                  {/* A single-unit donation has no quantity, as on the cart page. */}
                  {!(benefit && isSingleUnitContribution(l.product)) && (
                  <form method="POST" action={Astro.locals.urls.href('/api/cart')} class="flex items-center gap-2">
                    <input type="hidden" name="_action" value="update" />
                    <input type="hidden" name="key" value={l.key} />
                    <input
                      type="number"
                      name="qty"
                      min="0"
                      max="99"
                      value={l.qty}
                      aria-label={t('cart.line.quantity')}
                      class="w-12 border-b border-line bg-transparent py-0.5 text-center text-sm tabular-nums focus:border-brand focus:outline-none"
                    />
                    <button
                      type="submit"
                      class="text-xs uppercase tracking-widest text-faint hover:text-brand"
                    >
                      {t('cart.line.update')}
                    </button>
                  </form>
                  )}
                  <form method="POST" action={Astro.locals.urls.href('/api/cart')} class="flex items-center">
                    <input type="hidden" name="_action" value="remove" />
                    <input type="hidden" name="key" value={l.key} />
                    <button
                      type="submit"
                      class="text-xs uppercase tracking-widest text-faint hover:text-red-600"
                    >
                      {t('cart.line.remove')}
                    </button>
                  </form>
                </div>
              </div>
              <span class="shrink-0 text-sm tabular-nums">{formatPrice(l.lineTotalCents, undefined, Astro.locals.i18n.intl)}</span>
            </li>
          ))}
        </ul>

        {onlyFreeDonation && (
          <p class="mt-4 text-sm text-muted">
            {t('benefit.cart.perks.invite')}{' '}
            <a href={shopHref} class="border-b border-brand text-brand">{t('benefit.cart.perks.link')}</a>
          </p>
        )}

        <div class="mt-6 border-t border-line pt-4">
          <div class="flex items-center justify-between">
            <span class="text-xs uppercase tracking-widest text-muted">{t('cart.summary.subtotal')}</span>
            <span class="text-lg tabular-nums">{formatPrice(subtotalCents, undefined, Astro.locals.i18n.intl)}</span>
          </div>
          <a
            href={Astro.locals.urls.href('/express')}
            data-free-donation-ask={offerFreeDonation ? 'free-donation-drawer' : undefined}
            class="mt-4 block w-full rounded-md bg-brand px-6 py-3 text-center text-sm font-medium uppercase tracking-wider text-on-brand hover:bg-brand-hover"
          >
            {t('cart.drawer.checkout')}
          </a>
          <a
            href={Astro.locals.urls.cart()}
            class="mt-3 block text-center text-xs uppercase tracking-widest text-faint hover:text-brand"
          >
            {t('cart.drawer.viewFullCart')}
          </a>
        </div>
      </Fragment>
    )
  }
  {offerFreeDonation && benefit && freeDonationProduct && (
    <FreeDonation id="free-donation-drawer" product={freeDonationProduct} currency={currency} capCents={benefit.capCents} />
  )}
</div>
