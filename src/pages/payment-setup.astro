---
export const prerender = false;
import Layout from '../layouts/Layout.astro';

// Reached from the cart when a buyer taps a payment method that isn't configured
// yet. It's owner-facing setup help — how to turn that rail on — so the store can
// graduate from Demo to real payments without leaving a dead button.
const { t, th } = Astro.locals.i18n;
const method = (Astro.url.searchParams.get('method') ?? '').toLowerCase();
const origin = Astro.url.origin;

interface Guide {
  title: string;
  intro: string;
  steps: string[];
}
const GUIDES: Record<string, Guide> = {
  stripe: {
    title: t('checkout.setup.stripe.title'),
    intro: t('checkout.setup.stripe.intro'),
    steps: [
      t('checkout.setup.stripe.step1'),
      t('checkout.setup.stripe.step2'),
      t('checkout.setup.stripe.step3', { url: Astro.locals.urls.absolute('/api/webhook/stripe') }),
      t('checkout.setup.stripe.step4'),
    ],
  },
  lightning: {
    title: t('checkout.setup.lightning.title'),
    intro: t('checkout.setup.lightning.intro'),
    steps: [
      t('checkout.setup.lightning.step1'),
      t('checkout.setup.lightning.step2'),
      t('checkout.setup.lightning.step3'),
    ],
  },
  opennode: {
    title: t('checkout.setup.opennode.title'),
    intro: t('checkout.setup.opennode.intro'),
    steps: [
      t('checkout.setup.opennode.step1'),
      t('checkout.setup.opennode.step2'),
      t('checkout.setup.opennode.step3', { url: Astro.locals.urls.absolute('/api/webhook/opennode') }),
    ],
  },
};
const guide = GUIDES[method] ?? null;
---

<Layout title={t('checkout.setup.title')} description={t('checkout.setup.description')}>
  <div class="mx-auto max-w-xl py-8">
    <a href={Astro.locals.urls.cart()} class="text-xs uppercase tracking-widest text-faint hover:text-brand">
      &larr; {t('checkout.setup.back')}
    </a>

    {
      guide ? (
        <>
          <h1 class="mt-4 font-serif text-3xl tracking-tight">{guide.title}</h1>
          <p class="mt-3 text-muted">{guide.intro}</p>
          <ol class="mt-6 space-y-3">
            {guide.steps.map((s, i) => (
              <li class="flex gap-3 text-sm">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand/10 text-xs font-medium text-brand">
                  {i + 1}
                </span>
                <span class="pt-0.5 text-muted">{s}</span>
              </li>
            ))}
          </ol>
        </>
      ) : (
        <>
          <h1 class="mt-4 font-serif text-3xl tracking-tight">{t('checkout.setup.title')}</h1>
          <p class="mt-3 text-muted">
            <Fragment set:html={th('checkout.setup.notConfigured')} />
          </p>
        </>
      )
    }

    <div class="mt-8 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800">
      <Fragment set:html={th('checkout.setup.demoNote')} />
    </div>
  </div>
</Layout>
