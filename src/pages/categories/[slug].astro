---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import {
  getCategoryBySlug,
  ancestors,
  listCategories,
  childrenOf,
  productsInCategory,
  countProductsInCategory,
} from '../../features/categories/db';
import ProductCard from '#theme/ProductCard.astro';
import { buildProductCard } from '../../features/storefront/productCard';
import { getConfig } from '../../config';
import { orderByClause, parseStoreSortQuery } from '../../features/products/sort';
import {
  MAX_PUBLIC_PAGE,
  paginate,
  queryHref,
} from '../../pagination';
import Pagination from '../../components/Pagination.astro';
import CatalogSort from '../../features/storefront/controls/CatalogSort.astro';
import { buildSortModel } from '../../features/storefront/catalog';
import { catalogPath } from '../../features/settings/home';
import { addCacheTags, productCacheTags } from '../../features/cache/tags';
import { loadTranslations } from '../../features/translations/db';
import { translated, translatedAll } from '../../features/translations/content';
import { translatedLocalesByRow } from '../../features/translations/db';
import { languageSettings } from '../../features/i18n/settings';
import { requestSeo } from '../../features/i18n/seoRequest';
import { structuredData } from '../../features/i18n/structuredData';
import { publicOrigin } from '../../features/http/origin';

const { slug } = Astro.params;
const { i18n } = Astro.locals;
const { t } = i18n;
const sourceCategory = slug ? await getCategoryBySlug(env.DB, slug) : null;

if (!sourceCategory) {
  return new Response(t('storefront.error.notFound'), { status: 404 });
}

const { sort, dir } = parseStoreSortQuery(
  Astro.url.searchParams.get('sort'),
  Astro.url.searchParams.get('dir'),
);
const order = orderByClause(sort, dir);

const PAGE_SIZE = 24;
const [sourceTrail, categories, total] = await Promise.all([
  ancestors(env.DB, sourceCategory.id),
  listCategories(env.DB),
  countProductsInCategory(env.DB, sourceCategory.id),
]);
const sourceSubcats = childrenOf(categories, sourceCategory.id);
const { page, offset, totalPages } = paginate(
  Astro.url.searchParams,
  total,
  PAGE_SIZE,
  MAX_PUBLIC_PAGE,
);
const sourceProducts = await productsInCategory(env.DB, sourceCategory.id, PAGE_SIZE, offset, order);
// The visitor's language, one batched read; the slug and the products' prices
// stay the rows' own.
const tr = await loadTranslations(env.DB, Astro.locals.contentLocale, {
  category: [sourceCategory.id, ...sourceTrail.map((c) => c.id), ...sourceSubcats.map((c) => c.id)],
  product: sourceProducts.map((p) => p.id),
});
const category = translated(tr, 'category', sourceCategory);
const trail = translatedAll(tr, 'category', sourceTrail);
const subcats = translatedAll(tr, 'category', sourceSubcats);
const products = translatedAll(tr, 'product', sourceProducts);
addCacheTags(Astro.response.headers, productCacheTags(products.map((product) => product.public_id)));
// Presentation models are built here, where the store's image settings are
// known; only the first card is the LCP image.
const cards = products.map((product, i) =>
  buildProductCard(product, {
    href: Astro.locals.urls.href,
    baseUrl: getConfig().images.baseUrl,
    currency: getConfig().currency,
    intl: Astro.locals.i18n.intl,
    delivery: Astro.locals.settings?.imageDelivery,
    minimumContribution: Astro.locals.settings?.commerceMode === 'benefit',
    sizes: '(min-width: 1024px) 352px, calc(50vw - 36px)',
    priority: i === 0,
  }),
);
const base = Astro.locals.urls.category(category.slug);
const hrefFor = (p: number) =>
  queryHref(base, {
    sort: sort === 'newest' ? undefined : sort,
    dir: dir === 'desc' ? undefined : dir,
    page: p > 1 ? p : undefined,
  });
// The catalog is at / until the home page is pointed elsewhere.
const shopHref = Astro.locals.urls.href(catalogPath(Astro.locals.settings?.homePage));

// Canonical and hreflang follow whether the category NAME is translated (the
// products listed fall back one by one); the JSON-LD trail matches the page's.
const multilingual = languageSettings(Astro.locals.settings).enabledLocales.length > 1;
const translatedInto = multilingual
  ? ((await translatedLocalesByRow(env.DB, 'category', [sourceCategory])).get(sourceCategory.id) ?? [])
  : [];
const pageSeo = requestSeo(
  Astro.locals,
  publicOrigin(Astro.url.origin, env.CANONICAL_ORIGIN),
  Astro.locals.path,
  translatedInto,
);
const jsonLd = structuredData({
  seo: pageSeo,
  pageType: 'CollectionPage',
  name: category.name,
  breadcrumb: [
    { name: t('storefront.nav.shop'), url: pageSeo.absolute(catalogPath(Astro.locals.settings?.homePage)) },
    ...trail.filter((c) => c.id !== category.id).map((c) => ({ name: c.name, url: pageSeo.absolute(`/categories/${c.slug}`) })),
    { name: category.name, url: pageSeo.canonical },
  ],
});
---

<Layout title={category.name} seo={pageSeo}>
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  <nav class="mb-4 flex flex-wrap gap-x-2 text-xs uppercase tracking-widest text-faint">
    <a href={shopHref} class="hover:text-brand">{t('storefront.nav.shop')}</a>
    {
      trail.map((c) => (
        <span class="flex gap-x-2">
          <span aria-hidden="true">/</span>
          <a href={Astro.locals.urls.category(c.slug)} class="hover:text-brand">
            {c.name}
          </a>
        </span>
      ))
    }
  </nav>

  <h1 class="mb-8 font-serif text-4xl tracking-tight sm:text-5xl">{category.name}</h1>

  {
    subcats.length > 0 && (
      <div class="mb-12 flex flex-wrap gap-x-6 gap-y-2 text-xs uppercase tracking-widest text-muted">
        {subcats.map((c) => (
          <a
            href={Astro.locals.urls.category(c.slug)}
            class="border-b border-transparent pb-0.5 hover:border-brand hover:text-brand"
          >
            {c.name}
          </a>
        ))}
      </div>
    )
  }

  <CatalogSort model={buildSortModel(base, sort, dir, i18n)} i18n={i18n} />

  {products.length === 0 && <p class="text-muted">{t('storefront.category.empty')}</p>}

  <ul class="grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-3">
    {
      cards.map((card, i) => (
        <ProductCard card={card} index={i} i18n={i18n} />
      ))
    }
  </ul>

  <Pagination page={page} totalPages={totalPages} hrefFor={hrefFor} />
</Layout>
