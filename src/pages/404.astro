---
import Layout from '../layouts/Layout.astro';
import { catalogPath } from '../features/settings/home';

// Astro renders this for unmatched routes; set the status explicitly so SSR
// responses (and crawlers) get a real 404 rather than a 200.
Astro.response.status = 404;
// The catalog is at / until the home page is pointed elsewhere.
const shopHref = Astro.locals.urls.href(catalogPath(Astro.locals.settings?.homePage));
const { t, th } = Astro.locals.i18n;
---

<Layout title={t('storefront.notFound.title')} description={t('storefront.notFound.description')} noindex>
  <section class="reveal mx-auto max-w-xl py-16 text-center sm:py-24">
    <p class="text-xs uppercase tracking-[0.25em] text-muted">{t('storefront.notFound.eyebrow')}</p>
    <h1 class="mt-3 font-serif text-5xl tracking-tight sm:text-6xl">
      {t('storefront.notFound.title')}
    </h1>
    <p class="mx-auto mt-5 max-w-md text-sm text-muted">
      {/* set:html rather than {t()}: an expression would escape the apostrophe. */}
      <Fragment set:html={th('storefront.notFound.body')} />
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
      <a
        href={shopHref}
        class="rounded-md bg-brand px-5 py-2.5 text-xs font-medium uppercase tracking-wider text-on-brand transition hover:bg-brand-hover"
      >
        {t('storefront.nav.backToShop')}
      </a>
      <a
        href={Astro.locals.urls.search()}
        class="border-b border-transparent pb-0.5 text-xs uppercase tracking-widest text-muted transition hover:border-brand hover:text-brand"
      >
        {t('storefront.notFound.searchCatalog')}
      </a>
    </div>
  </section>
</Layout>
