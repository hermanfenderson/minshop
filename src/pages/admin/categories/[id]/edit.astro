---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import CategoryForm from '../../../../features/categories/CategoryForm.astro';
import {
  getCategoryByPublicId,
  listCategories,
  buildTree,
  flattenTree,
  descendantIds,
} from '../../../../features/categories/db';
import { parsePublicId } from '../../../../features/ids/publicId';
import TranslationEditor from '../../../../features/translations/TranslationEditor.astro';
import { editorLanguages, editorRows } from '../../../../features/translations/editor';

// The route param is the cat_ public ID; numeric row ids are not accepted.
const publicId = parsePublicId(Astro.params.id, 'category');
const category = publicId ? await getCategoryByPublicId(env.DB, publicId) : null;

if (!category) {
  return new Response('Not found', { status: 404 });
}

// A category can't be moved under itself or one of its descendants — exclude them.
const blocked = new Set(await descendantIds(env.DB, category.id));
const parentOptions = flattenTree(buildTree(await listCategories(env.DB))).filter(
  (o) => !blocked.has(o.id),
);
const error = Astro.url.searchParams.get('error');
const translation = editorLanguages(Astro.locals.settings);
const translationRows = translation.languages.length
  ? await editorRows(env.DB, 'category', [{ id: category.id, publicId: category.public_id, source: { name: category.name } }])
  : [];
---

<AdminLayout title={`Edit ${category.name}`} active="categories">
  <a href={Astro.locals.urls.href('/admin/categories')} class="text-sm text-gray-500 hover:text-brand">&larr; Back to categories</a>
  <h1 class="mt-4 mb-6 text-2xl font-bold">Edit category</h1>
  <CategoryForm
    action={Astro.locals.urls.href(`/api/admin/categories/${category.public_id}`)}
    submitLabel="Save changes"
    category={category}
    parentOptions={parentOptions}
    error={error}
  />
  <TranslationEditor
    scope="category"
    id={category.public_id ?? undefined}
    returnTo={`/admin/categories/${category.public_id}/edit`}
    source={translation.source}
    languages={translation.languages}
    rows={translationRows}
  />
</AdminLayout>
