---
import { cookieName } from '../../deployment';
export const prerender = false;
// Clears the admin session cookie and returns to the login form. Reached only
// when already authenticated (it's under the protected /admin/* path).
Astro.cookies.delete(cookieName('admin_session'), { path: '/' });
return Astro.redirect(Astro.locals.urls.href('/admin/login'), 303);
---
