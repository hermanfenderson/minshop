---
import { readForm } from '../features/http/form';
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { formatPrice } from '../config';
import { getProductByPublicId } from '../features/products/db';
import { sellableStock } from '../features/products/stock';
import { listVariants, getExtrasByPublicIds } from '../features/products/variants';
import { parsePublicId } from '../features/ids/publicId.ts';
import { lineUnitPriceCents } from '../features/cart/key';
import { purchaseLineName } from '../features/cart/lineName';
import { translatedPurchase, translatedVariantLabel } from '../features/translations/db';
import { shippingFor } from '../features/shipping/effective';
import { shipmentWeightFor } from '../features/shipping/lines';
import { stripeDestination } from '../features/shipping/destination';
import { readCart, resolveCart } from '../features/cart/cart';
import { enabledMethods } from '../features/payments';
import ProductImage from '../features/products/ProductImage.astro';
import { chosenVariantPublicId } from '../features/products/variantAxes';
import { getConfig } from '../config';
import { benefitMethods, benefitRules } from '../features/benefit/mode';
import { readContribution } from '../features/benefit/amount';
import { contributionError } from '../features/benefit/messages';
import { readDonorDraft } from '../features/benefit/donorDraft';
import DonorFields from '../features/benefit/DonorFields.astro';

// Express checkout — a single payment-method-picker step (first listed = the
// store's default). Two sources: "Buy now" (a single product_id [+ variant/extras])
// or the whole cart (no product_id → reads the cart cookie). Skips the full cart
// page; the chosen method posts to /api/checkout, carrying the same source.
const { t } = Astro.locals.i18n;
const isPost = Astro.request.method === 'POST';
const form = isPost ? await readForm(Astro.request) : null;
const fld = (n: string) => (form?.get(n) ?? Astro.url.searchParams.get(n) ?? '').toString().trim();
const currency = getConfig().currency;
// Benefit Mode: the amount chosen on the product page is the line's price.
const benefit = benefitRules(Astro.locals.settings, currency);

interface DisplayLine {
  name: string;
  imageKey: string | null;
  unitPriceCents: number;
  qty: number;
}

// Buy-now identifiers are prefixed public IDs (prod_/var_/xtra_); numeric row
// IDs are never accepted.
const productPublicId = parsePublicId(fld('product_id'), 'product');
const isBuyNow = productPublicId !== null;

let lines: DisplayLine[] = [];
// Parallel model for the shipping question only ("does anything here ship?") —
// the display lines deliberately drop the product/variant rows.
let weightLines: Parameters<typeof shipmentWeightFor>[0] = [];
// Fields each method form re-sends to /api/checkout to reproduce this exact order.
let carry: { name: string; value: string }[] = [];
let backHref = '/';

if (isBuyNow && productPublicId) {
  const product = await getProductByPublicId(env.DB, productPublicId);
  if (!product || !product.active) return Astro.redirect(Astro.locals.urls.home(), 303);
  backHref = Astro.locals.urls.product(product.slug);

  const requestedVariant = parsePublicId(fld('variant_id'), 'variant');
  const extraPublicIds = (isPost ? form!.getAll('extra') : Astro.url.searchParams.getAll('extra'))
    .map((e) => parsePublicId(e, 'extra'))
    .filter((x): x is string => x !== null);

  const variants = await listVariants(env.DB, product.id);
  // variant_id, or the multi-axis selector's option_<i> fields without JavaScript.
  const variantPublicId = chosenVariantPublicId(variants, product.variant_label, requestedVariant, fld);
  const variant =
    variants.length > 0 && variantPublicId
      ? (variants.find((v) => v.public_id === variantPublicId) ?? null)
      : null;
  if (variants.length > 0 && !variant) {
    return Astro.redirect(
      Astro.locals.urls.href(
        `/products/${product.slug}?error=${encodeURIComponent(
          t('checkout.error.chooseVariant', {
            label:
              (await translatedVariantLabel(env.DB, Astro.locals.contentLocale, product)) ||
              t('checkout.error.variantFallback'),
          }),
        )}`,
      ),
      303,
    );
  }
  const extras = extraPublicIds.length && !benefit
    ? await getExtrasByPublicIds(env.DB, product.id, extraPublicIds)
    : [];
  if (sellableStock(product, variant ? variant.stock : product.stock) <= 0) {
    return Astro.redirect(
      Astro.locals.urls.href(`/products/${product.slug}?${new URLSearchParams({ error: t('checkout.error.soldOut') })}`),
      303,
    );
  }
  const shown = await translatedPurchase(env.DB, Astro.locals.contentLocale, product, variant, extras);
  const name = purchaseLineName(shown.product, shown.variant, shown.extras);
  let unitPriceCents = lineUnitPriceCents(product.price_cents, variant, extras);
  if (benefit) {
    const minimumCents = unitPriceCents;
    const amount = fld('amount') ? readContribution(fld('amount'), currency, minimumCents, benefit.capCents) : { ok: true as const, cents: minimumCents };
    if (!amount.ok) {
      const message = contributionError(Astro.locals.i18n, amount.problem, { name, minimumCents, capCents: benefit.capCents, currency });
      return Astro.redirect(Astro.locals.urls.href(`/products/${product.slug}?error=${encodeURIComponent(message)}`), 303);
    }
    unitPriceCents = amount.cents;
  }
  lines = [
    {
      name,
      imageKey: product.image_key,
      unitPriceCents,
      qty: 1,
    },
  ];
  weightLines = [{ product, variant, qty: 1 }];
  carry = [{ name: 'product_id', value: productPublicId }];
  if (benefit) carry.push({ name: 'amount', value: fld('amount') || '' });
  if (variant?.public_id) carry.push({ name: 'variant_id', value: variant.public_id });
  for (const e of extras) {
    if (e.public_id) carry.push({ name: 'extra', value: e.public_id });
  }
} else {
  const { lines: cartLines } = await resolveCart(env.DB, readCart(Astro.cookies), Astro.locals.contentLocale, benefit);
  if (cartLines.length === 0) return Astro.redirect(Astro.locals.urls.cart(), 303);
  // Stock can drop between adding to the cart and checking out. Bounce to the cart
  // rather than rendering a total the shopper can't actually buy: this page has no
  // quantity or remove controls, and /cart already flags the offending line
  // ("Only N available"). reserveInventory is still the real guarantee — it catches
  // the race after this check — but that fires only once they've entered an address
  // and picked shipping, which is a late, frustrating place to be told.
  const short = cartLines.find((l) => l.qty > l.availableStock);
  if (short) {
    return Astro.redirect(
      Astro.locals.urls.href(`/cart?error=${encodeURIComponent(t('checkout.error.cartShort'))}`),
      303,
    );
  }
  backHref = Astro.locals.urls.cart();
  lines = cartLines.map((l) => ({
    name:
      l.product.name +
      (l.variant ? ` — ${l.variant.label}` : '') +
      (l.extras.length ? ` (${l.extras.map((e) => e.label).join(', ')})` : ''),
    imageKey: l.product.image_key,
    unitPriceCents: l.unitPriceCents,
    qty: l.qty,
  }));
  weightLines = cartLines.map((l) => ({ product: l.product, variant: l.variant, qty: l.qty }));
  carry = [{ name: 'source', value: 'cart' }];
}

const totalCents = lines.reduce((s, l) => s + l.unitPriceCents * l.qty, 0);

// Only the actually-usable rails, default first. None → no checkout (cart-style).
const offered = Astro.locals.settings ? enabledMethods(Astro.locals.settings) : [];
// Benefit Mode pays only on the rails that need no in-app address step.
const methods = benefit
  ? benefitMethods(offered, shippingFor(Astro.locals.settings).config.enabled && shipmentWeightFor(weightLines).shippingRequired)
  : offered;
if (methods.length === 0) return Astro.redirect(backHref, 303);
const donorDraft = benefit ? readDonorDraft(Astro.cookies) : {};
const error = Astro.url.searchParams.get('error');

const effectiveShipping = shippingFor(Astro.locals.settings).config;
const destination = stripeDestination(
  Astro.locals.settings,
  effectiveShipping,
  shipmentWeightFor(weightLines).shippingRequired,
  Astro.request.headers.get('cf-ipcountry'),
  Astro.locals.i18n,
);

const heading = isBuyNow ? t('checkout.express.buyNow') : t('checkout.page.heading');
const METHOD: Record<string, { label: string; hint: string }> = {
  stripe: { label: t('checkout.method.stripe.label'), hint: t('checkout.method.stripe.hint') },
  lightning: { label: t('checkout.method.lightning.label'), hint: t('checkout.method.lightning.hint') },
  opennode: { label: t('checkout.method.opennode.label'), hint: t('checkout.method.opennode.hint') },
  demo: { label: t('checkout.method.demo.label'), hint: t('checkout.method.demo.hint') },
};
---

<Layout title={t('checkout.page.title')} description={t('checkout.express.description')}>
  <div class="mx-auto max-w-md">
    <p class="text-xs uppercase tracking-[0.25em] text-muted">{t('checkout.express.eyebrow')}</p>
    <h1 class="mt-2 mb-6 font-serif text-3xl tracking-tight sm:text-4xl">{heading}</h1>

    <ul class="divide-y divide-line border-y border-line">
      {
        lines.map((l) => (
          <li class="flex items-center gap-4 py-4">
            <ProductImage
              imageKey={l.imageKey}
              alt=""
              usage="thumbnail"
              fade
              class="h-16 w-16 shrink-0 rounded object-cover"
            />
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium">{l.name}</p>
              <p class="text-xs text-muted">{t('checkout.express.qty', { qty: l.qty })}</p>
            </div>
            <span class="tabular-nums">{formatPrice(l.unitPriceCents * l.qty)}</span>
          </li>
        ))
      }
    </ul>

    <div class="mt-4 flex items-center justify-between">
      <span class="text-xs uppercase tracking-widest text-muted">{benefit ? t('benefit.cart.total') : t('checkout.express.total')}</span>
      <span class="text-lg tabular-nums">{formatPrice(totalCents)}</span>
    </div>

    {error && (
      <p class="mt-4 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">{error}</p>
    )}

    {/* Benefit Mode: ONE form, so the donor details travel with whichever rail
        is chosen (the rails are the submit buttons, as on the cart). */}
    {benefit && (
      <form method="POST" action={Astro.locals.urls.href('/api/checkout')} class="mt-6 space-y-2">
        {carry.map((c) => <input type="hidden" name={c.name} value={c.value} />)}
        <DonorFields
          draft={donorDraft}
          defaultCountry={Astro.request.headers.get('cf-ipcountry')}
          privacyHref={Astro.locals.settings?.benefitPrivacyHref ?? null}
        />
        {destination.showSelect && (
          <label class="mb-2 flex items-center justify-between gap-2 text-xs uppercase tracking-widest text-muted">
            {t('checkout.express.shipTo')}
            <select name="country" class="rounded-md border border-line px-2 py-1.5 text-sm normal-case tracking-normal text-ink">
              {destination.countries.map((c) => (
                <option value={c} selected={c === destination.defaultCountry}>{destination.label(c)}</option>
              ))}
            </select>
          </label>
        )}
        {destination.hiddenOnly && <input type="hidden" name="country" value={destination.countries[0]} />}
        {methods.map((m, i) => (
          <button
            type="submit"
            name="method"
            value={m}
            class={`flex w-full items-center justify-between gap-3 rounded-lg px-5 py-3 text-left transition ${
              i === 0 ? 'bg-brand text-on-brand hover:bg-brand-hover' : 'border border-line text-muted hover:border-brand'
            }`}
          >
            <span>
              <span class="block text-sm font-medium">{METHOD[m]?.label ?? m}</span>
              <span class={`block text-xs ${i === 0 ? 'text-on-brand/70' : 'text-muted'}`}>{METHOD[m]?.hint ?? ''}</span>
            </span>
            <span aria-hidden="true" class={i === 0 ? 'text-on-brand/80' : 'text-faint'}>&rarr;</span>
          </button>
        ))}
      </form>
    )}

    {/* One button per enabled method (first = the store's default → primary). Each
        re-sends the same source to /api/checkout with its method. */}
    <div class="mt-6 space-y-2" hidden={Boolean(benefit)}>
      {
        !benefit && methods.map((m, i) => (
          <form method="POST" action={Astro.locals.urls.href('/api/checkout')}>
            {carry.map((c) => (
              <input type="hidden" name={c.name} value={c.value} />
            ))}
            <input type="hidden" name="method" value={m} />
            {/* Stripe prices its static rate list from this choice; the other
                rails collect the address on /checkout. A single remaining country
                still submits, or the server would fall back to the raw first
                zone — possibly the very country the Stripe filter removed. */}
            {m === 'stripe' && destination.showSelect && (
              <label class="mb-2 flex items-center justify-between gap-2 text-xs uppercase tracking-widest text-muted">
                {t('checkout.express.shipTo')}
                <select
                  name="country"
                  class="rounded-md border border-line px-2 py-1.5 text-sm normal-case tracking-normal text-ink"
                >
                  {destination.countries.map((c) => (
                    <option value={c} selected={c === destination.defaultCountry}>
                      {destination.label(c)}
                    </option>
                  ))}
                </select>
              </label>
            )}
            {m === 'stripe' && destination.hiddenOnly && (
              <input type="hidden" name="country" value={destination.countries[0]} />
            )}
            <button
              type="submit"
              class={`flex w-full items-center justify-between gap-3 rounded-lg px-5 py-3 text-left transition ${
                i === 0
                  ? 'bg-brand text-on-brand hover:bg-brand-hover'
                  : 'border border-line text-muted hover:border-brand'
              }`}
            >
              <span>
                <span class="block text-sm font-medium">{METHOD[m]?.label ?? m}</span>
                <span class={`block text-xs ${i === 0 ? 'text-on-brand/70' : 'text-muted'}`}>
                  {METHOD[m]?.hint ?? ''}
                </span>
              </span>
              <span aria-hidden="true" class={i === 0 ? 'text-on-brand/80' : 'text-faint'}>
                &rarr;
              </span>
            </button>
          </form>
        ))
      }
    </div>

    <a
      href={backHref}
      class="mt-6 inline-block text-xs uppercase tracking-widest text-faint hover:text-brand"
    >
      &larr; {t('checkout.express.back')}
    </a>
  </div>
</Layout>
