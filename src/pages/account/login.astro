---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import {
  accountsEnabled,
  requestLogin,
  isValidEmail,
  getCustomerEmail,
} from '../../features/auth/customer';
import { verifyConfiguredTurnstile, TURNSTILE_FIELD } from '../../features/auth/turnstile';
import { getSecret } from '../../features/secrets/store';
import Turnstile from '../../features/auth/Turnstile.astro';

if (!(await accountsEnabled())) return Astro.redirect(Astro.locals.urls.home(), 303);
// Already signed in → account.
if (await getCustomerEmail(Astro.cookies)) return Astro.redirect(Astro.locals.urls.account(), 303);

const { t, th } = Astro.locals.i18n;
let sent = false;
let error = Astro.url.searchParams.get('error') === 'expired' ? t('account.login.expired') : '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '');
  // Bot challenge (if enabled in Settings → Bot protection): verify with the vault secret.
  const turnstileEnabled = Astro.locals.settings?.turnstileEnabled === true;
  const tsSecret = turnstileEnabled
    ? await getSecret(env.DB, 'turnstile_secret_key')
    : null;
  const tsOk = await verifyConfiguredTurnstile(
    turnstileEnabled,
    form.get(TURNSTILE_FIELD)?.toString(),
    tsSecret,
    Astro.request.headers.get('CF-Connecting-IP'),
  );
  if (!tsOk) {
    error = t('account.login.verificationFailed');
  } else if (!isValidEmail(email)) {
    error = t('account.login.invalidEmail');
  } else {
    await requestLogin(email, Astro.locals);
    sent = true;
  }
}
---

<Layout title={t('account.login.title')}>
  <div class="mx-auto max-w-sm py-10">
    <h1 class="mb-2 font-serif text-3xl tracking-tight sm:text-4xl">{t('account.login.heading')}</h1>

    {
      sent ? (
        <p class="rounded-md border border-line bg-surface px-4 py-3 text-sm text-muted">
          {t('account.login.sent')}
        </p>
      ) : (
        <Fragment>
          <p class="mb-5 text-sm text-muted">
            <Fragment set:html={th('account.login.intro')} />
          </p>
          {error && (
            <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
              {error}
            </p>
          )}
          <form method="POST" class="space-y-3">
            <input
              type="email"
              name="email"
              required
              autofocus
              autocomplete="email"
              placeholder={t('account.login.emailPlaceholder')}
              class="w-full rounded-md border border-line px-3 py-2"
            />
            <div class="flex justify-center">
              <Turnstile />
            </div>
            <button
              type="submit"
              class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-on-brand hover:bg-brand-hover"
            >
              {t('account.login.submit')}
            </button>
          </form>
        </Fragment>
      )
    }
  </div>
</Layout>
